# ─────────────────────────────────────────────────────────────
# Kaiju — exemple de configuration. Copier en « .env » et adapter.
# Ne JAMAIS mettre de secret réel dans ce fichier d'exemple.
# ─────────────────────────────────────────────────────────────

# Port du serveur (console + API + temps réel + fichiers participants)
PORT=4000

# Hôte d'écoute. 0.0.0.0 = accessible depuis le LAN (requis pour les smartphones).
HOST=0.0.0.0

# Environnement : development | production
NODE_ENV=development

# Secret de signature des sessions organisateur.
# Généré automatiquement au premier lancement s'il est absent (stocké hors dépôt).
# Pour le fixer manuellement : chaîne aléatoire longue.
SESSION_SECRET=

# Chemin du fichier SQLite (relatif à la racine du serveur par défaut)
DATABASE_PATH=./data/kaiju.sqlite

# Dossier des sauvegardes
BACKUP_DIR=./backups

# Dossier des médias uploadés
UPLOAD_DIR=./uploads

# Langue par défaut de l'interface : fr | en
DEFAULT_LOCALE=fr

# Limites sûres (non désactivables par l'organisateur)
MAX_PARTICIPANTS=200
MAX_IMAGE_BYTES=5242880
AUTO_BACKUP_MINUTES=10
RATE_WINDOW_MS=10000
RATE_MAX_ACTIONS=30
